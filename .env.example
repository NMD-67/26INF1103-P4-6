# PostgreSQL URI from your project's Connect panel (never paste real secrets here).
SUPABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/postgres
# Gmail app password for the configured sender.
EMAIL_PASSWORD=
# Scoring key. Alternatively configure GROQ_KEY_NAMES with named key variables.
PROFILE_MATCHING_API_KEY=
# Optional conversation suggestions; backup can be used on its own.
MATCHMAKING_API_KEY=
RAPH_AI_KEY=
